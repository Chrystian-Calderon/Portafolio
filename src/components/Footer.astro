---
import "../styles/global.css";
import { Image } from "astro:assets";
import imgLogo from "../images/logo portafolio.png";
import imgGithub from "../images/Github_light.svg";
import imgLinkedin from "../images/linkedin.svg";
import imgGmail from "../images/gmail.svg";
---

<footer class="bg-500 text-50">
  <div class="flex items-center justify-between gap-4 py-4 w-5xl mx-auto">
    <Image src={imgLogo} alt="logo" width={50} height={50} />
    <span>Chrystian Calderon {new Date().getFullYear()}</span>
    <div class="flex items-center gap-4">
      <a href="https://github.com/Chrystian-Calderon" target="_blank" rel="noopener noreferrer">
        <Image src={imgGithub} alt="GitHub" width={24} height={24} />
      </a>
      <a href="https://www.linkedin.com/in/chrystian-calderon" target="_blank" rel="noopener noreferrer">
        <Image src={imgLinkedin} alt="LinkedIn" width={24} height={24} />
      </a>
      <div class="relative flex flex-col items-center">
        <div id="gmail-link" class="cursor-pointer" title="Click to copy email">
          <Image src={imgGmail} alt="Gmail" width={24} height={24} />
        </div>
        <div id="gmail-feedback" class="absolute top-full mt-1 text-xs text-green-300 bg-900 px-2 py-1 rounded shadow opacity-0 pointer-events-none transition-opacity duration-300">¡Correo copiado!</div>
      </div>
    </div>
  </div>
</footer>

<script is:inline>
  const gmailLink = document.getElementById("gmail-link");
  const gmailFeedback = document.getElementById("gmail-feedback");
  gmailLink.addEventListener("click", () => {
    const email = "chrystianralfc@gmail.com";
    navigator.clipboard.writeText(email)
      .then(() => {
        gmailFeedback.style.opacity = "1";
        setTimeout(() => {
          gmailFeedback.style.opacity = "0";
        }, 1500);
      })
      .catch(() => {
        gmailFeedback.textContent = "Error al copiar";
        gmailFeedback.style.opacity = "1";
        setTimeout(() => {
          gmailFeedback.style.opacity = "0";
          gmailFeedback.textContent = "¡Correo copiado!";
        }, 1500);
      });
  });
</script>