---
import { Image } from "astro:assets";
import Button from "./button.astro";
const { title, description, image, technologies, links } = Astro.props;
---

<div>
  <div>
    <Image src={image.src} alt={image.alt} class="w-auto" />
  </div>
  <h5>{title}</h5>
  {description && <p>{description}</p>}
  <div>
    <h6>Technologies</h6>
    {
      technologies.map((technologie, index) => (
        <div class="h-6 w-auto" key={index}>
          <Image src={technologie.src} alt={technologie.alt} class="w-auto" />
        </div>
      ))
    }
  </div>
  <div>
    {links[0] && <Button text={links[0].name} />}
    {links[1] && <Button text={links[1].name} />}
  </div>
</div>
