---
import { Image } from "astro:assets";
const { imgSrc, alt, position } = Astro.props;
---

<div class="w-[500px] h-[360px] relative">
  <Image src={imgSrc} alt={alt} class="w-full h-full relative z-2 rounded-xl" />
  <div
    class={`rounded-xl border-20 border-500 w-full h-full absolute top-12 ${position == "left" ? "-left-12" : "-right-12"}`}
  >
  </div>
</div>
