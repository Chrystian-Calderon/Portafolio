---
import "../styles/global.css";
import { Image } from "astro:assets";
import logo from "../images/logo portafolio.png";
---

<nav class="sticky top-0 z-50">
  <div class="flex justify-between px-25 py-3 relative bg-950">
    <a href="/" class="flex gap-3">
      <div class="img-logo">
        <Image src={logo} alt="logo" width="50" height="50" />
      </div>
      <h1 class="hidden sm:block text-50 font-h2">Chrys Ralf</h1>
    </a>
    <!-- nav link -->
    <div class="nav-link">
      <div id="home-link-container"></div>
      <div><a href="#projects">Projects</a></div>
      <div><a href="#contact">Contact</a></div>
      <div><a href="/en/about">About me</a></div>
      <div class="language">
        <button id="lang-en" type="button" class="px-2 py-1 rounded transition cursor-pointer">EN</button>
        <button id="lang-es" type="button" class="px-2 py-1 rounded transition cursor-pointer">ES</button>
      </div>
    </div>
    <!-- hamburger -->
    <button
      type="button"
      class="relative inline-flex items-center justify-center rounded-md p-2 text-gray-400 hover:bg-gray-700 hover:text-white focus:ring-2 focus:ring-white focus:outline-hidden focus:ring-inset sm:hidden"
      id="btn-hamburger"
      aria-controls="mobile-menu"
      aria-expanded="false"
    >
      <svg
        class="block size-6"
        fill="none"
        viewBox="0 0 24 24"
        stroke-width="1.5"
        stroke="currentColor"
        aria-hidden="true"
        data-slot="icon"
      >
        <path
          stroke-linecap="round"
          stroke-linejoin="round"
          d="M3.75 6.75h16.5M3.75 12h16.5m-16.5 5.25h16.5"></path>
      </svg>
      <svg
        class="hidden size-6"
        fill="none"
        viewBox="0 0 24 24"
        stroke-width="1.5"
        stroke="currentColor"
        aria-hidden="true"
        data-slot="icon"
      >
        <path
          stroke-linecap="round"
          stroke-linejoin="round"
          d="M6 18 18 6M6 6l12 12"></path>
      </svg>
    </button>
  </div>
  <div
    class="absolute left-0 top-full w-full duration-700 ease-in-out transform -translate-y-60 opacity-0 pointer-events-none hidden sm:hidden"
    id="mobile-menu"
  >
    <div class="text-center space-y-1 bg-600">
      <a
        href=""
        class="block border-b-2 font-h4 text-50 transition hover:font-bold hover:bg-[var(--color-700)]"
        >Home</a
      >
      <a
        href=""
        class="block border-b-2 font-h4 text-50 transition hover:font-bold hover:bg-[var(--color-700)]"
        >Projects</a
      >
      <a
        href=""
        class="block border-b-2 font-h4 text-50 hover:font-bold hover:bg-[var(--color-700)]"
        >Contact</a
      >
      <a
        href=""
        class="block border-b-2 font-h4 text-50 hover:font-bold hover:bg-[var(--color-700)]"
        >About me</a
      >
      <div class="flex w-full">
        <button id="lang-en-mobile" type="button" class="w-1/2 font-h4 text-50 family-roboto px-2 py-1 rounded transition cursor-pointer">EN</button>
        <button id="lang-es-mobile" type="button" class="w-1/2 font-h4 text-50 family-roboto px-2 py-1 rounded transition cursor-pointer">ES</button>
      </div>
    </div>
  </div>
</nav>
<script is:inline>
  // detect language and set active button
  const path = window.location.pathname;
  const isEs = /\/es(\/|$)/.test(path);
  const isEn = /\/en(\/|$)/.test(path);

  const btnEn = document.getElementById("lang-en");
  const btnEs = document.getElementById("lang-es");
  const btnEnMobile = document.getElementById("lang-en-mobile");
  const btnEsMobile = document.getElementById("lang-es-mobile");

  function setLangActive(esActive) {
    if (esActive) {
      btnEs.classList.add("bg-800", "text-white", "font-bold");
      btnEn.classList.remove("bg-800", "text-white", "font-bold");
      btnEsMobile.classList.add("bg-800", "text-white", "font-bold");
      btnEnMobile.classList.remove("bg-800", "text-white", "font-bold");
    } else {
      btnEn.classList.add("bg-800", "text-white", "font-bold");
      btnEs.classList.remove("bg-800", "text-white", "font-bold");
      btnEnMobile.classList.add("bg-800", "text-white", "font-bold");
      btnEsMobile.classList.remove("bg-800", "text-white", "font-bold");
    }
  }

  setLangActive(isEs);

  // home link dinamic
  const homeLinkContainer = document.getElementById('home-link-container');
  let homeLink = null;
  const lang = path.split('/')[1];
  if (path === '/en' || path === '/es') {
    homeLink = document.createElement('a');
    homeLink.href = '#main';
    homeLink.textContent = 'Home';
    homeLink.className = 'cursor-pointer';
  } else if (isEn) {
    homeLink = document.createElement('a');
    homeLink.href = '/en';
    homeLink.textContent = 'Home';
    homeLink.className = 'cursor-pointer';
  } else if (isEs) {
    homeLink = document.createElement('a');
    homeLink.href = '/es';
    homeLink.textContent = 'Home';
    homeLink.className = 'cursor-pointer';
  }
  if (homeLink) homeLinkContainer.appendChild(homeLink);

  // scroll gently
  document.querySelectorAll('.nav-link a[href^="#"], #home-link-container a[href^="#"]').forEach(link => {
    link.addEventListener('click', function(e) {
      const targetId = this.getAttribute('href').slice(1);
      const target = document.getElementById(targetId);
      if (target) {
        e.preventDefault();
        target.scrollIntoView({ behavior: 'smooth' });
      }
    });
  });

  // language buttons
  btnEn.addEventListener("click", () => {
    if (!isEn) window.location.href = "/en";
  });
  btnEs.addEventListener("click", () => {
    if (!isEs) window.location.href = "/es";
  });
  btnEnMobile.addEventListener("click", () => {
    if (!isEn) window.location.href = "/en";
  });
  btnEsMobile.addEventListener("click", () => {
    if (!isEs) window.location.href = "/es";
  });
</script>
<script is:inline>
  const btnHamburger = document.getElementById("btn-hamburger");
  const mobileMenu = document.getElementById("mobile-menu");
  const btnHamburgerIcon = btnHamburger.querySelectorAll("svg");

  btnHamburger.addEventListener("click", () => {
    const btnHamburgerClick = btnHamburger.ariaExpanded === "true";

    btnHamburger.ariaExpanded = !btnHamburgerClick;
    if (btnHamburgerClick) {
      btnHamburgerIcon[0].classList.remove("hidden");
      btnHamburgerIcon[1].classList.add("hidden");
      mobileMenu.classList.remove(
        "translate-y-0",
        "opacity-100",
        "pointer-events-auto"
      );
      mobileMenu.classList.add(
        "-translate-y-60",
        "opacity-0",
        "pointer-events-none"
      );
      setTimeout(() => {
        mobileMenu.classList.toggle("hidden");
      }, 700);
    } else {
      btnHamburgerIcon[0].classList.add("hidden");
      btnHamburgerIcon[1].classList.remove("hidden");
      mobileMenu.classList.toggle("hidden");
      requestAnimationFrame(() => {
        mobileMenu.classList.remove(
          "-translate-y-60",
          "opacity-0",
          "pointer-events-none"
        );
        mobileMenu.classList.add(
          "translate-y-0",
          "opacity-100",
          "pointer-events-auto"
        );
      });
    }
  });
</script>
