---
import Layout from "../../layouts/Layout.astro";
import { Image } from "astro:assets";
import imgGitHub from "../../images/Github_dark.svg";
import imgLinkedin from "../../images/linkedin.svg";
import imgHTML from "../../images/html5.svg";
import imgCSS from "../../images/css_old.svg";
import imgJS from "../../images/javascript.svg";
import imgJava from "../../images/java.svg";
import imgPython from "../../images/python.svg";
import imgPHP from "../../images/php_dark.svg";
import imgExpress from "../../images/expressjs_dark.svg";
import imgReact from "../../images/react_dark.svg";
import imgBootstrap from "../../images/bootstrap.svg";
import imgSpring from "../../images/spring.svg";
import imgTailwind from "../../images/tailwindcss.svg";
import imgMySQL from "../../images/mysql.svg";
import imgGit from "../../images/git.svg";
import imgPostman from "../../images/postman.svg";
import imgAstro from "../../images/astro_dark.svg";
import imgPerfil from "../../images/perfil.png";
import imgProject1 from "../../images/img-morkup.jpg";
import imgChibi from "../../images/ralf_chibi.png";

import Button from "../../components/button.astro";
import IconLanguage from "../../components/IconLanguage.astro";
import ImgCard from "../../components/ImgCard.astro";

const items = [
  { src: imgHTML, label: "HTML", alt: "logo html", minW: "67" },
  { src: imgCSS, label: "CSS", alt: "logo css", minW: "58" },
  { src: imgJS, label: "JavaScript", alt: "logo javascript", minW: "98" },
  { src: imgJava, label: "Java", alt: "logo java", minW: "56" },
  { src: imgPython, label: "Python", alt: "logo python", minW: "76" },
  { src: imgPHP, label: "", alt: "logo php", minW: "48" },
  { src: imgExpress, label: "ExpressJS", alt: "logo express", minW: "100" },
  { src: imgReact, label: "React", alt: "logo react", minW: "71" },
  { src: imgBootstrap, label: "Bootstrap", alt: "logo bootstrap", minW: "100" },
  {
    src: imgTailwind,
    label: "Tailwind CSS",
    alt: "logo tailwind css",
    minW: "129",
  },
  { src: imgMySQL, label: "MySQL", alt: "logo mysql", minW: "77" },
  { src: imgGit, label: "Git", alt: "logo git", minW: "50" },
  { src: imgPostman, label: "Postman", alt: "logo postman", minW: "89" },
];

const carouselItems = [...items, ...items];
const floatIcons = [
  { src: imgHTML, alt: "logo html", top: "-30px", left: "30px" },
  { src: imgCSS, alt: "logo css", top: "20px", left: "140px" },
  { src: imgJS, alt: "logo javascript", top: "-100px", left: "220px" },
  { src: imgJava, alt: "logo java", top: "-20px", left: "320px" },
  { src: imgPython, alt: "logo python", top: "100px", left: "420px" },
  { src: imgExpress, alt: "logo express", top: "20px", left: "80px" },
  { src: imgReact, alt: "logo react", top: "80px", left: "200px" },
  { src: imgBootstrap, alt: "logo bootstrap", top: "30px", left: "400px" },
  { src: imgSpring, alt: "logo bootstrap", top: "80px", left: "600px" },
];
const floatIconsTop = floatIcons.slice(0, 5);
const floatIconsButtom = floatIcons.slice(5, 9);
---

<Layout>
  <!-- main -->
  <div class="main">
    <div class="main-content">
      <div class="main-content-icons">
        {
          floatIconsTop.map((icon) => (
            <div class="icons" style={`top: ${icon.top}; left: ${icon.left}`}>
              <Image src={icon.src} alt={icon.alt} width="30" height="30" />
            </div>
          ))
        }
      </div>
      <div class="main-content-body">
        <h2 class="font-h2">Hi<br />I'm Chrystian Calderon</h2>
        <span class="font-h3">Developer Back-End</span>
        <div>
          <Button text="DOWNLOAD CV" />
          <Button text="CONTACT" />
        </div>
        <div>
          <Image src={imgGitHub} alt="logo github" width={30} height={30} />
          <Image src={imgLinkedin} alt="logo linkedin" width={30} height={30} />
        </div>
      </div>
      <div class="main-content-icons">
        {
          floatIconsButtom.map((icon) => (
            <div class="icons" style={`top: ${icon.top}; left: ${icon.left}`}>
              <Image src={icon.src} alt={icon.alt} width="30" height="30" />
            </div>
          ))
        }
      </div>
    </div>
    <div class="perfil">
      <Image src={imgAstro} alt="logo astro" width={80} class="perfil-astro" />
      <Image src={imgPerfil} alt="autor Chrystian" width={400} class="autor" />
    </div>
  </div>
  <!-- projects -->
  <div class="projects bg-grandient-custom">
    <div class="projects-content">
      <h2 class="mb-5">Proyects</h2>
      <div class="card">
        <div class="card-body">
          <h3 class="font-bold">
            Implementing MVC in Node.js: How to Pass the Model as a Parameter
            from the Router to the Controller
          </h3>
          <p>
            Implementing MVC in Node.js: How to Pass the Model as a Parameter
            from the Router to the Controller.
          </p>
          <div class="card-tech">
            <h3 class="font-bold">Technologies</h3>
            <div>
              <IconLanguage
                imgSrc={imgReact}
                alt="image react"
                width="30"
                height="30"
              />
              <IconLanguage
                imgSrc={imgBootstrap}
                alt="image bootstrap"
                width="30"
                height="30"
              />
              <IconLanguage
                imgSrc={imgExpress}
                alt="image express"
                width="30"
                height="30"
              />
            </div>
          </div>
          <div class="card-buttons">
            <Button text="View" />
            <Button text="Github" color="bg-gray-200" textColor="text-black" />
          </div>
        </div>
        <ImgCard imgSrc={imgProject1} alt="img project" position="left" />
      </div>
      <div class="card card-reverse">
        <div class="card-body">
          <h3 class="font-bold">
            Implementing MVC in Node.js: How to Pass the Model as a Parameter
            from the Router to the Controller
          </h3>
          <p>
            Implementing MVC in Node.js: How to Pass the Model as a Parameter
            from the Router to the Controller.
          </p>
          <div class="card-tech">
            <h3 class="font-bold">Technologies</h3>
            <div>
              <IconLanguage
                imgSrc={imgReact}
                alt="image react"
                width="30"
                height="30"
              />
              <IconLanguage
                imgSrc={imgBootstrap}
                alt="image bootstrap"
                width="30"
                height="30"
              />
              <IconLanguage
                imgSrc={imgExpress}
                alt="image express"
                width="30"
                height="30"
              />
            </div>
          </div>
          <div class="card-buttons">
            <Button text="View" />
            <Button text="Github" color="bg-gray-200" textColor="text-black" />
          </div>
        </div>
        <ImgCard imgSrc={imgProject1} alt="img project" position="right" />
      </div>
      <div class="card">
        <div class="card-body">
          <h3 class="font-bold">
            Implementing MVC in Node.js: How to Pass the Model as a Parameter
            from the Router to the Controller
          </h3>
          <p>
            Implementing MVC in Node.js: How to Pass the Model as a Parameter
            from the Router to the Controller.
          </p>
          <div class="card-tech">
            <h3 class="font-bold">Technologies</h3>
            <div>
              <IconLanguage
                imgSrc={imgReact}
                alt="image react"
                width="30"
                height="30"
              />
              <IconLanguage
                imgSrc={imgBootstrap}
                alt="image bootstrap"
                width="30"
                height="30"
              />
              <IconLanguage
                imgSrc={imgExpress}
                alt="image express"
                width="30"
                height="30"
              />
            </div>
          </div>
          <div class="card-buttons">
            <Button text="View" />
            <Button text="Github" color="bg-gray-200" textColor="text-black" />
          </div>
        </div>
        <ImgCard imgSrc={imgProject1} alt="img project" position="left" />
      </div>
    </div>
    <div>
      <Button text="See More" />
    </div>
  </div>
  <!-- tech stack -->
  <div class="bg-950 text-50 pb-2">
    <h5 class="text-center font-bold py-3">Tech Stack</h5>
    <div class="overflow-hidden w-full">
      <div
        class="inline-flex gap-4 whitespace-nowrap animate-scroll items-center transform-x-[50%]"
      >
        {
          carouselItems.map((item, index) => (
            <div class={`flex items-center mr-10`}>
              <Image
                src={item.src}
                alt={item.alt}
                class={`mr-5`}
                style={`min-width: 30px; height: 30px;`}
              />
              {/* <span class="text-sm">{item.label}</span> */}
            </div>
          ))
        }
      </div>
    </div>
  </div>
  <!-- contact -->
  <div class="contact">
    <div class="contact-content">
      <h2>Contact Us</h2>
      <div
        class="flex flex-col md:flex-row items-center md:items-stretch w-full"
      >
        <form class="flex-1 w-full">
          <div class="input">
            <input type="text" name="name" id="name" placeholder="" />
            <label for="name">Name</label>
          </div>
          <div class="input">
            <input type="email" name="email" id="email" placeholder="" />
            <label for="email">Email</label>
          </div>
          <div class="input">
            <textarea name="message" id="message" rows="5" placeholder=""
            ></textarea>
            <label for="message">Message</label>
          </div>
          <div class="w-fit">
            <Button text="Send" />
          </div>
        </form>
        <div class="flex-1 flex justify-center items-center w-full">
          <Image
            src={imgChibi}
            alt="Chrys Ralf Chibi"
            class="w-auto h-full max-h-[500px] md:max-h-[400px] sm:max-h-[250px] object-contain"
          />
        </div>
      </div>
    </div>
  </div>
</Layout>
